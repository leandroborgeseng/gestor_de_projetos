# Variáveis de Ambiente para Coolify
# Copie este arquivo e configure no painel do Coolify

# ============================================
# BANCO DE DADOS
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua-senha-super-segura-aqui
POSTGRES_DB=agilepm
DATABASE_URL=postgresql://postgres:sua-senha-super-segura-aqui@db:5432/agilepm

# ============================================
# API BACKEND
# ============================================
NODE_ENV=production
PORT=4000
JWT_SECRET=seu-jwt-secret-super-seguro-mude-isso-em-producao
JWT_REFRESH_SECRET=seu-refresh-secret-super-seguro-mude-isso-em-producao
FRONTEND_URL=https://seu-dominio.com

# ============================================
# FRONTEND
# ============================================
VITE_API_URL=https://seu-dominio.com

# ============================================
# NOTAS
# ============================================
# 1. Substitua "seu-dominio.com" pelo seu domínio real
# 2. Gere secrets seguros para JWT_SECRET e JWT_REFRESH_SECRET
# 3. Use uma senha forte para POSTGRES_PASSWORD
# 4. No Coolify, configure essas variáveis em cada serviço:
#    - db: POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB
#    - api: DATABASE_URL, JWT_SECRET, JWT_REFRESH_SECRET, PORT, FRONTEND_URL
#    - web: VITE_API_URL

